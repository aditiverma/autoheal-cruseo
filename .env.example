# Crusoe Managed Inference (OpenAI-compatible endpoint)
CRUSOE_API_KEY=your_key_here
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1

# Reasoning model for diagnosis / planning / definition-of-done.
# Discover what your org has with: python main.py models
CRUSOE_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B

# Advisory safety reviewer uses a smaller/faster Nemotron (right model for the
# job). Falls back to CRUSOE_MODEL if unset.
CRUSOE_SAFETY_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
